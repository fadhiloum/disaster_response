# Data backend selector:
# - demo: in-memory sample data, no database required
# - prisma: PostgreSQL via Prisma using DATABASE_URL
# - drizzle: reserved for the Drizzle/D1 adapter
DATA_BACKEND=demo

DATABASE_URL="postgresql://postgres:postgres@localhost:5432/disaster_response?schema=public"

# OpenAI Platform integration.
# Keep this server-side only. Do not prefix it with NEXT_PUBLIC_.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# Runtime auth is demo-backed in the first slice.
# Choose NextAuth or Supabase Auth before enabling production login.
